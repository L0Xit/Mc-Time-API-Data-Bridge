# Email method: simulate, smtp, sendgrid, mailgun, webhook
EMAIL_METHOD=webhook

# Webhook configuration
EMAIL_WEBHOOK_URL=http://127.0.0.1:5001/send-email
EMAIL_WEBHOOK_TOKEN=test-token
SENDER_EMAIL=noreply@tgm-adapter.com

# For SMTP (Gmail example):
# EMAIL_METHOD=smtp
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SENDER_EMAIL=your-email@gmail.com
# SENDER_PASSWORD=your-app-password

# For SendGrid:
# EMAIL_METHOD=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDER_EMAIL=noreply@your-domain.com

# For Mailgun:
# EMAIL_METHOD=mailgun
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-domain.com
# SENDER_EMAIL=noreply@your-domain.com