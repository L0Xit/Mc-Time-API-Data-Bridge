# Email Configuration
# Choose one of: smtp, sendgrid, mailgun, webhook, simulate
EMAIL_METHOD=simulate

# === SMTP Configuration (Traditional Email) ===
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password

# === SendGrid Configuration ===
SENDGRID_API_KEY=your-sendgrid-api-key

# === Mailgun Configuration ===
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-domain.com

# === Custom Webhook Configuration ===
EMAIL_WEBHOOK_URL=https://your-webhook-service.com/send-email
EMAIL_WEBHOOK_TOKEN=your-webhook-token

# === General Email Settings ===
SENDER_EMAIL=noreply@your-company.com