# ========================================
# TGM-Adapter Environment Configuration
# ========================================
# IMPORTANT: Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git!

# === McTime API Configuration ===
MCTIME_API_KEY=your-api-key-here

# === Email Configuration ===
# Choose one of: smtp, sendgrid, mailgun, webhook, simulate
EMAIL_METHOD=smtp

# === SMTP Configuration (AWS SES or other SMTP provider) ===
SMTP_SERVER=email-smtp.eu-west-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SENDER_EMAIL=noreply@mctime.com
USE_TLS=true

# === SendGrid Configuration (Alternative) ===
# SENDGRID_API_KEY=your-sendgrid-api-key

# === Mailgun Configuration (Alternative) ===
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-domain.com

# === Custom Webhook Configuration (Alternative) ===
# EMAIL_WEBHOOK_URL=https://your-webhook-service.com/send-email
# WEBHOOK_TOKEN=your-webhook-security-token

# === Application Settings ===
PORT=5000
FLASK_ENV=development
DEBUG=true